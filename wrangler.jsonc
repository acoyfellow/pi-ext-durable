{
  "name": "pi-ext-durable",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@earendil-works/pi-coding-agent": "./src/pi-coding-agent-shim.ts" },
